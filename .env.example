# Supabase — get from Vercel env vars (already configured)
NEXT_PUBLIC_SUPABASE_URL=https://eefqcgetyxdrvchkwhrq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# MLS / IDX
SIMPLYRETS_API_KEY=
SIMPLYRETS_API_SECRET=

# Home Valuation API
RENTCAST_API_KEY=

# Email
RESEND_API_KEY=

# Agent portal (private contract submission)
AGENT_PORTAL_PASSWORD=

# Google
GOOGLE_PLACES_API_KEY=
GOOGLE_ANALYTICS_ID=

# Basemap (optional) — MapLibre style URL for the Pipeline maps.
# Defaults to OpenFreeMap positron, which is keyless. Set this to move providers
# (e.g. a keyed CARTO or MapTiler style) without a code change.
NEXT_PUBLIC_MAP_STYLE_URL=

# Nashville Open Data (no key required — public)
NASHVILLE_PERMITS_API=https://data.nashville.gov/resource/96ap-mfmf.json
